.stats-page{padding-bottom:48rpx}.stats-kicker{margin:20rpx 2rpx 18rpx;display:flex;justify-content:space-between;color:var(--dp-secondary);font-size:23rpx}.stats-kicker text:first-child{font-size:32rpx;font-weight:700;color:var(--dp-text)}.hero-panel{position:relative;min-height:232rpx;padding:30rpx;overflow:hidden;border-radius:30rpx;background:linear-gradient(125deg,#9e1111,#e21413 58%,#ef605b);color:#fff;box-shadow:0 18rpx 36rpx rgba(184,30,28,.2)}.hero-decoration{position:absolute;right:-58rpx;top:-54rpx;width:230rpx;height:230rpx;border:34rpx solid rgba(255,255,255,.14);border-radius:50%}.hero-copy,.hero-side{position:relative;display:flex;flex-direction:column}.hero-label{font-size:25rpx;opacity:.88}.hero-rate{margin:6rpx 0;font-size:78rpx;font-weight:700;line-height:1}.hero-caption{font-size:23rpx;opacity:.86}.hero-side{position:absolute;right:30rpx;top:38rpx;align-items:flex-end;font-size:21rpx;opacity:.9}.hero-side text:nth-child(2){margin:4rpx 0;font-size:46rpx;font-weight:700}.hero-track{position:absolute;left:30rpx;right:30rpx;bottom:30rpx;height:12rpx;overflow:hidden;border-radius:8rpx;background:rgba(255,255,255,.25)}.hero-track view{height:100%;border-radius:8rpx;background:#fff}.section-title{display:flex;align-items:center;gap:12rpx;margin:36rpx 4rpx 18rpx;font-size:30rpx;font-weight:700}.section-title>text{width:7rpx;height:29rpx;border-radius:4rpx;background:var(--dp-red)}.priority-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.priority-card{min-height:142rpx;padding:24rpx;box-sizing:border-box;border-radius:24rpx;background:#fff;border:1rpx solid var(--dp-border);display:flex;flex-direction:column}.priority-card .priority-label{font-size:23rpx;color:var(--dp-secondary)}.priority-card .priority-value{margin:8rpx 0 3rpx;font-size:48rpx;font-weight:700}.priority-card>text:last-child{font-size:20rpx;color:var(--dp-muted)}.priority-card.danger .priority-value{color:var(--dp-red)}.priority-card.warning .priority-value{color:var(--dp-warning)}.priority-card.alert .priority-value{color:#d15a00}.priority-card.muted .priority-value{color:#667085}.type-panel{padding:8rpx 28rpx}.type-row{padding:24rpx 0;border-bottom:1rpx solid var(--dp-border)}.type-row:last-child{border:0}.type-row-head{display:flex;justify-content:space-between;gap:18rpx;font-size:25rpx}.type-row-head text:last-child{flex:none;color:var(--dp-secondary);font-size:22rpx}.type-progress{height:12rpx;margin:14rpx 0 9rpx;overflow:hidden;border-radius:8rpx;background:#f0f1f4}.type-progress view{height:100%;border-radius:8rpx;background:linear-gradient(90deg,#f96766,#e21413)}.type-outstanding{font-size:21rpx;color:var(--dp-secondary)}.type-outstanding.done{color:var(--dp-success)}.attendance-panel{display:flex;align-items:center;justify-content:space-between;padding:28rpx}.attendance-copy{display:flex;flex-direction:column;gap:9rpx;color:var(--dp-secondary);font-size:21rpx}.attendance-title{color:var(--dp-text);font-size:28rpx;font-weight:700}.attendance-values{display:flex;gap:22rpx}.attendance-values view{display:flex;flex-direction:column;align-items:center;gap:6rpx;color:var(--dp-muted);font-size:19rpx}.attendance-values view text:first-child{font-size:34rpx;font-weight:700}.recent-panel{padding:6rpx 28rpx}.recent-row{min-height:92rpx;display:flex;align-items:center;justify-content:space-between;gap:22rpx;border-bottom:1rpx solid var(--dp-border)}.recent-row:last-child{border:0}.recent-row view{min-width:0;display:flex;flex:1;flex-direction:column;gap:6rpx}.recent-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:25rpx}.recent-type,.recent-time{color:var(--dp-muted);font-size:20rpx}.recent-time{flex:none}.empty-inline{padding:32rpx 0;text-align:center;color:var(--dp-muted);font-size:23rpx}.stats-loading{padding-top:30rpx}.skeleton{background:linear-gradient(90deg,#edf0f4,#f7f8fa,#edf0f4);border-radius:24rpx}.hero-skeleton{height:232rpx}.row-skeleton{height:150rpx;margin-top:22rpx}.warning{color:var(--dp-warning)}.danger{color:var(--dp-red)}.success{color:var(--dp-success)}
