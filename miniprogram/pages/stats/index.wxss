.period{margin:30rpx 0 18rpx;font-size:32rpx;font-weight:600}.rate-card{padding:34rpx}.rate-card>text{display:block}.rate{margin:18rpx 0;font-size:72rpx;font-weight:700;color:var(--dp-red)}.rate-line{height:16rpx;background:#f0f1f4;border-radius:8rpx;overflow:hidden}.rate-line view{height:100%;background:linear-gradient(148.66deg,#f96766,#e21413)}.stats-grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx;margin-top:20rpx}.stats-grid .card{padding:30rpx}.stats-grid text{display:block}.stats-grid text:last-child{font-size:52rpx;font-weight:700;margin-top:20rpx}.warning{color:var(--dp-warning)}.danger{color:var(--dp-red)}.success{color:var(--dp-success)}.note{margin-top:20rpx;padding:28rpx;color:#737b8c;line-height:1.6}
