.home-page { padding-bottom: 60rpx; background: radial-gradient(circle at 50% 0, #eef5ff 0, #f7f8fa 32%, #f5f6f8 100%); }
.home-title { height: 86rpx; display: flex; justify-content: center; align-items: center; font-size: 38rpx; font-weight: 700; }
.identity { height: 98rpx; display: flex; align-items: center; }
.brand-logo { width: 94rpx; height: 58rpx; padding: 5rpx 8rpx; border-radius: 50%; background: #fff; box-shadow: 0 4rpx 14rpx rgba(48,49,51,.06); }
.identity-copy { margin-left: 14rpx; display: flex; align-items: baseline; gap: 10rpx; }
.identity-name { font-size: 28rpx; font-weight: 600; }.identity-role { color: var(--dp-muted); font-size: 21rpx; }
.chevron { margin-left: auto; font-size: 40rpx; }
.today-card { position: relative; height: 386rpx; margin: 0 8rpx; padding: 26rpx 28rpx 0; overflow: hidden; border: 2rpx solid rgba(255,255,255,.9); border-radius: 28rpx; background: linear-gradient(135deg, rgba(255,255,255,.98), rgba(247,250,255,.86)); box-shadow: 0 10rpx 28rpx rgba(48,49,51,.08); }
.today-grid { position: absolute; inset: 0; opacity: .3; background-image: linear-gradient(120deg, transparent 45%, #dce8f6 46%, transparent 47%), radial-gradient(circle at 75% 38%, #fff 0, transparent 45%); }
.today-label { position: relative; display: flex; align-items: center; font-size: 31rpx; font-weight: 600; }.today-label text { width: 7rpx; height: 30rpx; margin-right: 14rpx; border-radius: 4rpx; background: var(--dp-red); }
.today-main { position: relative; display: flex; align-items: baseline; margin-top: 12rpx; color: var(--dp-red); font-size: 33rpx; font-weight: 700; }.today-number { margin-right: 8rpx; font-size: 68rpx; line-height: 1; }
.today-tip { position: relative; margin-top: 10rpx; color: var(--dp-secondary); font-size: 24rpx; }
.today-art { position: absolute; right: 24rpx; top: 52rpx; width: 174rpx; height: 148rpx; transform: scale(.84); transform-origin: right top; }.sheet { position: absolute; width: 120rpx; height: 142rpx; border: 2rpx solid #ff9b9b; border-radius: 20rpx; background: linear-gradient(145deg,#fff,#ffd9dd); box-shadow: 0 12rpx 28rpx rgba(226,20,19,.16); }.s1{left:0;top:22rpx}.s2{left:28rpx;top:10rpx}.s3{left:54rpx;top:36rpx;background:linear-gradient(145deg,#ff8b8b,#e21413)}.clock{position:absolute;right:-2rpx;bottom:-10rpx;width:68rpx;height:68rpx;border:7rpx solid #e21413;border-radius:50%;background:#fff;color:#e21413;display:flex;align-items:center;justify-content:center;font-size:36rpx;font-weight:700}
.metrics-panel { position: absolute; left: 18rpx; right: 18rpx; bottom: 18rpx; height: 108rpx; padding: 16rpx 0; display: grid; grid-template-columns: repeat(4,1fr); border-radius: 22rpx; background: rgba(255,255,255,.94); box-shadow: 0 8rpx 22rpx rgba(48,49,51,.08); }
.metric { display: flex; flex-direction: column; align-items: center; gap: 5rpx; color: var(--dp-secondary); font-size: 24rpx; border-right: 1rpx solid var(--dp-border); }.metric:last-child{border-right:0}.metric-value{font-size:36rpx;color:var(--dp-red);font-weight:700}.metric .orange{color:var(--dp-warning)}.metric .green{color:var(--dp-success)}
.module-section { margin-top: 24rpx; padding: 30rpx 20rpx; }.module-head{display:flex;align-items:center;padding:0 6rpx 22rpx;font-size:34rpx;font-weight:600}
.module-grid{display:grid;grid-template-columns:1fr;gap:16rpx}.module-item{min-height:118rpx;padding:20rpx 22rpx;display:flex;align-items:center;border:1rpx solid var(--dp-border);border-radius:24rpx;background:#fff}.module-icon{width:78rpx;height:78rpx;flex:none;border-radius:22rpx;display:flex;align-items:center;justify-content:center;font-size:24rpx;font-weight:700}.tone-red{color:#e21413;background:#fff1f1}.tone-orange{color:#ed6c02;background:#fff4e5}.tone-blue{color:#3b82f6;background:#eff6ff}.tone-green{color:#16a34a;background:#f0fdf4}.module-copy{min-width:0;margin-left:20rpx;display:flex;flex:1;flex-direction:column;gap:8rpx}.module-name{font-size:29rpx;font-weight:600}.module-desc{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--dp-muted);font-size:22rpx}.module-arrow{margin-left:18rpx;font-size:40rpx;color:var(--dp-red)}
.brand-banner{position:relative;margin-top:24rpx;height:180rpx;padding:28rpx;display:flex;align-items:flex-start;overflow:hidden;background:linear-gradient(120deg,#fff,#f7eee8)}.brand-banner image{width:110rpx;height:42rpx}.brand-banner>view:nth-child(2){position:absolute;left:30rpx;top:76rpx;display:flex;flex-direction:column}.banner-title{font-size:36rpx;font-weight:700;color:#9f1010}.banner-sub{margin-top:12rpx}.banner-shape{position:absolute;right:-50rpx;bottom:-70rpx;width:330rpx;height:230rpx;transform:rotate(-12deg);background:linear-gradient(145deg,#ead7ca,#8d1b12);border-radius:40rpx}
