.execution-page{padding-bottom:180rpx}.loading-card{height:420rpx}.summary{margin-top:20rpx;padding:24rpx 30rpx;display:grid;grid-template-columns:1fr 1fr}.summary-cell{min-height:122rpx;padding:16rpx 20rpx;border-bottom:1rpx solid var(--dp-border)}.summary-cell:nth-child(odd){border-right:1rpx solid var(--dp-border)}.summary-cell:nth-child(n+3){border-bottom:0}.summary-label{display:flex;align-items:center;gap:10rpx;color:#737b8c}.summary-label image{width:30rpx;height:30rpx;flex:0 0 30rpx}.summary-value{display:block;margin-top:20rpx;font-size:30rpx;color:#111}.location-card{margin-top:28rpx;padding:28rpx;display:flex;align-items:center}.pin{width:88rpx;height:88rpx;flex:0 0 88rpx;border:2rpx solid #ffd9d9;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#fff6f6}.pin-icon{width:52rpx;height:52rpx}.location-copy{flex:1;min-width:0;padding:0 20rpx;color:#737b8c}.location-copy text{display:block}.location-title{margin-bottom:10rpx;color:#111;font-size:32rpx;font-weight:600}.location-address{display:-webkit-box!important;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2;color:#5f6878;font-size:24rpx;line-height:34rpx;word-break:break-all}.location-distance{margin-top:7rpx;color:var(--dp-red);font-size:23rpx;line-height:32rpx}.location-gate-tip{margin-top:7rpx;color:var(--dp-red);font-size:21rpx;line-height:30rpx}.check-button{width:154rpx;height:84rpx;line-height:84rpx;margin:0;flex:0 0 154rpx;border-radius:22rpx;background:linear-gradient(148.66deg,#f96766,#e21413);color:#fff;font-size:30rpx;font-weight:600}.check-button[disabled]{background:#f3a7a7;color:#fff}.items-title{margin:42rpx 2rpx 20rpx;font-size:34rpx;font-weight:600}.item-list{padding:10rpx 28rpx}.item-row{height:116rpx;display:flex;align-items:center;border-bottom:1rpx solid var(--dp-border)}.item-row:last-child{border-bottom:0}.item-row.entry-locked{background:#fafafa}.item-no{width:92rpx;font-size:34rpx;font-weight:700;color:#111}.item-name{flex:1;font-size:30rpx;color:#111}.entry-locked .item-no,.entry-locked .item-name,.entry-locked .enter{color:var(--dp-muted)}.entry-gate{flex:none;padding:8rpx 14rpx;border-radius:18rpx;background:var(--dp-red-subtle);color:var(--dp-red);font-size:20rpx}.enter{margin-left:18rpx;color:#777;font-size:48rpx}.submit-tip{margin:30rpx 0 0;display:flex;align-items:center;justify-content:center;gap:10rpx;text-align:center;color:#737b8c}.submit-tip image{width:32rpx;height:32rpx;flex:0 0 32rpx}.fixed-footer .primary-button{width:100%;border:0}
.execution-page.read-only{padding-bottom:44rpx}.readonly-tip{margin-bottom:18rpx}
