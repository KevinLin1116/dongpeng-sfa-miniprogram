.daily-page{padding-bottom:180rpx}.calendar{margin-top:20rpx;padding:28rpx}.month-head{display:flex;justify-content:space-between;align-items:center;font-size:34rpx;font-weight:700}.month-head text:first-child,.month-head text:last-child{font-size:48rpx;color:var(--dp-secondary)}.week,.day-grid{display:grid;grid-template-columns:repeat(7,1fr);text-align:center}.week{margin-top:24rpx;color:var(--dp-muted);font-size:23rpx}.day-grid{margin-top:14rpx}.day{height:82rpx;padding-top:8rpx;border-radius:14rpx;font-size:26rpx}.day.selected{background:#fff0f0;color:var(--dp-red);font-weight:700}.dots{display:flex;justify-content:center;gap:6rpx;margin-top:9rpx}.dot{display:inline-block;width:10rpx;height:10rpx;border-radius:50%;background:#d9dde5}.dot.normal{background:#23a56a}.dot.abnormal{background:#e92b2d}.dot.missed{background:#f59e0b}.legend{display:flex;gap:28rpx;margin-top:18rpx;padding-top:18rpx;border-top:1rpx solid var(--dp-border);font-size:22rpx;color:var(--dp-secondary)}.legend-item{display:flex;align-items:center;gap:8rpx}.legend-dot{width:12rpx;height:12rpx;border-radius:50%;background:#d9dde5}.legend-dot.normal{background:#23a56a}.legend-dot.abnormal{background:#e92b2d}.legend-dot.missed{background:#f59e0b}.section-title{margin:28rpx 8rpx 14rpx;font-size:32rpx;font-weight:700}.records{display:flex;flex-direction:column;gap:16rpx}.record-card{padding:24rpx;background:#fff;border-radius:24rpx}.record-head{display:flex;justify-content:space-between;align-items:flex-start;padding-bottom:20rpx;border-bottom:1rpx solid var(--dp-border)}.period{display:block;margin-bottom:8rpx;color:#1f2329;font-size:30rpx;font-weight:700}.time-window{font-size:23rpx;color:var(--dp-secondary)}.record-status{flex:none;padding:7rpx 13rpx;border-radius:10rpx;font-size:22rpx}.record-status.completed{color:#168759;background:#eaf8f1}.record-status.abnormal{color:#cf2528;background:#fff0f0}.record-status.missed{color:#c67500;background:#fff3de}.record-status.pending{color:#4d78b8;background:#edf4ff}.record-detail{display:flex;gap:20rpx;padding-top:18rpx;font-size:24rpx;line-height:1.5}.detail-label{flex:none;width:112rpx;color:var(--dp-secondary)}.detail-value{color:#1f2329;word-break:break-all}.detail-empty{color:var(--dp-muted)}.empty{padding:46rpx 0;text-align:center;color:var(--dp-muted)}
