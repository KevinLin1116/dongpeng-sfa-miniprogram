<view class="page daily-page"><view class="safe-top"></view><view class="nav"><view class="nav-back" bindtap="goBack">‹</view><text class="nav-title">日常考勤</text></view>
<view class="calendar card"><view class="month-head"><text data-delta="-1" bindtap="changeMonth">‹</text><text>{{month}}</text><text data-delta="1" bindtap="changeMonth">›</text></view><view class="week"><text>日</text><text>一</text><text>二</text><text>三</text><text>四</text><text>五</text><text>六</text></view><view class="day-grid"><view wx:for="{{days}}" wx:key="date" class="day {{item.date===selectedDate?'selected':''}}" data-date="{{item.date}}" bindtap="selectDate"><text>{{item.day}}</text><view class="dots"><text class="dot {{item.morning}}"></text><text class="dot {{item.afternoon}}"></text></view></view></view><view class="legend"><view class="legend-item"><view class="legend-dot normal"></view><text>正常</text></view><view class="legend-item"><view class="legend-dot abnormal"></view><text>辖区异常</text></view><view class="legend-item"><view class="legend-dot missed"></view><text>缺卡</text></view></view></view>
<view class="section-title">{{selectedDate}} 打卡记录</view><view class="records"><view wx:if="{{!tasks.length}}" class="empty card">当天无需打卡或尚未生成记录</view><view wx:for="{{tasks}}" wx:key="id" class="record-card"><view class="record-head"><view><text class="period">{{item.dailyAttendancePeriodLabel}}</text><text class="time-window">{{item.timeText}}</text></view><text class="record-status {{item.statusTone}}">{{item.statusLabel}}</text></view><view class="record-detail"><text class="detail-label">打卡地址</text><text class="detail-value {{item.checkInAddress?'':'detail-empty'}}">{{item.addressText}}</text></view><view class="record-detail"><text class="detail-label">打卡时间</text><text class="detail-value {{item.checkedInAt?'':'detail-empty'}}">{{item.checkInTimeText}}</text></view></view></view>
<view class="fixed-footer"><button class="primary-button" disabled="{{!executableTaskId}}" bindtap="checkIn">{{actionText}}</button></view></view>
