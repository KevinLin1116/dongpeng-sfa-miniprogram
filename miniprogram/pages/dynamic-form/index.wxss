.form-page{padding-bottom:180rpx}.form-card{margin-top:20rpx;min-height:600rpx;padding:30rpx}.form-head{display:flex;align-items:center;justify-content:space-between;font-size:30rpx;color:#525a6d}.field{position:relative;margin-top:38rpx}.field-label{display:block;margin-bottom:16rpx;font-size:28rpx;font-weight:500;color:#111}.required{color:var(--dp-red);margin-right:6rpx}.control,.textarea{width:100%;border:1rpx solid #d9dee8;border-radius:14rpx;background:#fff;color:#303133;font-size:28rpx}.control{height:84rpx;padding:0 22rpx;display:flex;align-items:center;justify-content:space-between}.textarea{height:172rpx;padding:22rpx}.counter{position:absolute;right:18rpx;bottom:14rpx;color:#9098a8}.images{display:flex;gap:18rpx;flex-wrap:wrap}.upload,.image-wrap{width:126rpx;height:126rpx;border-radius:12rpx}.upload{border:2rpx dashed #c8ced9;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#7a8496}.upload .upload-plus{margin:0;font-size:46rpx;line-height:46rpx;font-weight:300}.upload .upload-text{margin-top:10rpx;font-size:22rpx;line-height:26rpx}.image-wrap{position:relative}.image-wrap image{width:100%;height:100%;border-radius:12rpx}.image-wrap>text{position:absolute;right:-10rpx;top:-12rpx;width:34rpx;height:34rpx;border-radius:50%;background:var(--dp-red);color:#fff;text-align:center;line-height:31rpx}.hint{display:block;margin-top:10rpx;color:#7a8496}.fixed-footer .primary-button{width:100%;border:0}
.watermark-canvas{position:fixed;left:-10000px;top:-10000px;width:300px;height:300px;pointer-events:none}
.readonly-banner{margin-top:24rpx;padding:18rpx 22rpx;border-radius:12rpx;background:#f5f6f8;color:#737b8c;text-align:center;font-size:25rpx}.control-readonly{background:#f7f8fa;color:#4f5665}.form-page.read-only{padding-bottom:44rpx}
