.detail-page{padding-bottom:190rpx}.detail-card{margin-top:20rpx;padding:30rpx}.task-card{margin-top:12rpx}.detail-grid{display:grid;grid-template-columns:150rpx 1fr;gap:18rpx;margin-top:28rpx}.detail-grid text:nth-child(odd){color:#909399}.answer{padding:24rpx 0;border-bottom:1rpx solid var(--dp-border)}.answer text{display:block}.answer text:first-child{color:#909399;margin-bottom:10rpx}
.review-toolbar{position:sticky;z-index:12;top:calc(env(safe-area-inset-top) + 106rpx);margin:20rpx 0 0;padding:18rpx 28rpx;display:flex;align-items:center;justify-content:space-between;gap:18rpx;background:#fff7f7;border-top:1rpx solid #ffdede;border-bottom:1rpx solid #ffdede;box-shadow:0 8rpx 22rpx rgba(45,49,55,.08)}.review-counts{display:flex;flex-wrap:wrap;gap:8rpx 18rpx;color:var(--dp-secondary);font-size:21rpx}.review-counts .good{color:var(--dp-success)}.review-counts .bad{color:var(--dp-red)}.mark-all{flex:none;height:58rpx;margin:0;padding:0 20rpx;border:1rpx solid #ffb9b9;border-radius:29rpx;background:#fff;color:var(--dp-red);font-size:22rpx;line-height:56rpx}
.compatibility-error{margin:20rpx 28rpx 0;padding:20rpx;border:1rpx solid #ffc8c8;border-radius:14rpx;background:var(--dp-red-subtle);color:var(--dp-red);font-size:23rpx;line-height:1.55}
.content-card{margin-top:0;border-radius:0}.evidence-group{margin-top:24rpx;border:1rpx solid var(--dp-border);border-radius:18rpx;overflow:hidden}.evidence-group-head,.evidence-product-head{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.evidence-group-head{min-height:86rpx;padding:0 22rpx;background:#f8f9fb}.group-name,.group-meta{display:block}.group-name{font-size:28rpx;font-weight:600;color:var(--dp-text)}.group-meta{margin-top:7rpx;color:var(--dp-muted);font-size:20rpx}.chevron{width:14rpx;height:14rpx;flex:none;border-right:3rpx solid #8c95a4;border-bottom:3rpx solid #8c95a4;transform:rotate(45deg);transition:transform .18s ease}.chevron.expanded{transform:rotate(225deg)}
.evidence-product{border-top:1rpx solid var(--dp-border);background:#fff}.evidence-product.historical-qualified{background:#fbfefc}.evidence-product-head{min-height:112rpx;padding:18rpx 22rpx}.product-copy{min-width:0;flex:1}.product-name,.product-spec,.previous-reason{display:block}.product-name{font-size:25rpx;font-weight:500;color:var(--dp-text)}.product-spec{margin-top:6rpx;color:var(--dp-muted);font-size:21rpx}.previous-reason{margin-top:8rpx;color:var(--dp-red);font-size:21rpx;line-height:1.45}.qualified-lock{flex:none;padding:7rpx 13rpx;border-radius:18rpx;background:var(--dp-success-subtle);color:var(--dp-success);font-size:21rpx;font-weight:600}.product-review-body{padding:0 22rpx 24rpx}.images{display:flex;gap:14rpx;flex-wrap:wrap}.images image{width:150rpx;height:150rpx;border-radius:12rpx;background:var(--dp-canvas)}
.decision-row{display:flex;gap:16rpx;margin-top:22rpx}.decision{height:68rpx;flex:1;margin:0;border-radius:34rpx;background:#f3f5f7;color:var(--dp-secondary);font-size:24rpx;line-height:66rpx}.decision.qualified.active{border:1rpx solid #8bd7aa;background:var(--dp-success-subtle);color:var(--dp-success)}.decision.unqualified.active{border:1rpx solid #ffabab;background:var(--dp-red-subtle);color:var(--dp-red)}.reason-input{box-sizing:border-box;width:100%;height:150rpx;margin-top:18rpx;padding:18rpx;border:1rpx solid #ffc8c8;border-radius:14rpx;background:#fffafa;font-size:23rpx;line-height:1.55}
.history{padding:22rpx 0;border-bottom:1rpx solid var(--dp-border)}.history text{display:block;margin-top:8rpx}.history text:first-child{font-weight:600}.history text:nth-child(2){color:#909399}.actions{display:flex;gap:20rpx}.actions button{flex:1;margin:0}.actions .primary-button{height:80rpx;border:0}.actions .product-submit{width:100%;flex:1}
.review-alert-mask{position:fixed;z-index:60;inset:0;padding:40rpx;display:flex;align-items:center;justify-content:center;background:rgba(22,25,31,.48)}.review-alert-panel{width:100%;max-width:640rpx;max-height:70vh;padding:30rpx;border-radius:28rpx;background:#fff;box-shadow:0 24rpx 70rpx rgba(0,0,0,.22)}.review-alert-head{display:flex;align-items:flex-start;gap:18rpx}.review-alert-symbol{width:48rpx;height:48rpx;flex:none;display:flex;align-items:center;justify-content:center;border-radius:50%;background:var(--dp-red-subtle);color:var(--dp-red);font-size:28rpx;font-weight:700}.review-alert-title,.review-alert-message{display:block}.review-alert-title{font-size:30rpx;font-weight:600}.review-alert-message{margin-top:8rpx;color:var(--dp-secondary);font-size:23rpx;line-height:1.5}.review-alert-list{max-height:280rpx;margin-top:24rpx}.review-alert-item{margin-bottom:14rpx;padding:18rpx;border-radius:12rpx;background:var(--dp-red-subtle);font-size:23rpx;line-height:1.5}.review-alert-button{height:76rpx;margin:24rpx 0 0;border-radius:38rpx;background:var(--dp-canvas);color:var(--dp-secondary);font-size:25rpx;font-weight:600;line-height:76rpx}
