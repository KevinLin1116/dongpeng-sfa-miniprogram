.login-page{min-height:100vh;padding:0 40rpx;background:linear-gradient(160deg,#fff 0%,#f8f9fb 42%,#f3f5f8 100%);box-sizing:border-box}.brand-zone{padding:110rpx 8rpx 54rpx}.brand-capsule{height:146rpx;padding:0 42rpx;box-sizing:border-box;display:flex;align-items:center;border:3rpx solid #22242a;border-radius:80rpx;background:rgba(255,255,255,.82);box-shadow:0 20rpx 44rpx rgba(43,47,54,.08)}.brand-logo{width:292rpx;height:74rpx;flex-shrink:0}.brand-divider{width:2rpx;height:56rpx;margin:0 26rpx;background:#d7d9df}.brand-name{display:flex;align-items:baseline;gap:12rpx;color:#22242a;font-size:50rpx;font-weight:700;letter-spacing:2rpx;white-space:nowrap}.brand-sfa{color:#e21413;font-size:58rpx;font-weight:800;letter-spacing:0}.brand-caption{margin:24rpx 14rpx 0;color:#8b909a;font-size:24rpx;letter-spacing:2rpx}.login-card{position:relative;padding:52rpx 40rpx 46rpx;border:1rpx solid #e7e9ee;border-radius:32rpx;background:#fff;box-shadow:0 20rpx 60rpx rgba(34,36,42,.07);overflow:hidden}.card-accent{position:absolute;top:0;left:40rpx;width:88rpx;height:8rpx;border-radius:0 0 8rpx 8rpx;background:#e21413}.title{font-size:46rpx;font-weight:700;color:#22242a;letter-spacing:1rpx}.desc{margin-top:18rpx;color:#737985;font-size:27rpx;line-height:1.7}.field{margin-top:40rpx}.field>text{display:block;margin-bottom:16rpx;color:#2e3138;font-size:29rpx;font-weight:600}.field input{height:98rpx;padding:0 28rpx;box-sizing:border-box;border:1rpx solid #e7e9ee;border-radius:18rpx;background:#fafafa;color:#22242a;font-size:30rpx}.field input:focus{border-color:#e21413;background:#fff}.login-button{margin-top:58rpx;width:100%;height:98rpx;border-radius:49rpx;font-size:32rpx;font-weight:600;letter-spacing:4rpx;line-height:98rpx;box-shadow:0 14rpx 28rpx rgba(226,20,19,.2)}.checking{height:220rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:24rpx;color:var(--dp-secondary)}.spinner{width:44rpx;height:44rpx;border:6rpx solid #f7c5c5;border-top-color:#e21413;border-radius:50%;animation:spin 1s linear infinite}.system-error{margin-top:40rpx;padding:26rpx;border-radius:16rpx;background:#fff5f5;color:#e21413;line-height:1.6}.system-error text:last-child{display:block;margin-top:14rpx;font-weight:600}.login-help{padding:36rpx 20rpx 72rpx;text-align:center;color:#999fa9;font-size:24rpx;line-height:1.7}@keyframes spin{to{transform:rotate(360deg)}}
.password-input{display:flex;align-items:center;border:1rpx solid #e7e9ee;border-radius:18rpx;background:#fafafa}.password-input input{flex:1;border:0;background:transparent}.password-input text{margin:0;padding:20rpx 24rpx;color:#e21413;font-size:24rpx;font-weight:600}
