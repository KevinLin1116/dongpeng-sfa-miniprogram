.search-row{display:flex;gap:16rpx;margin:18rpx 0 20rpx}.search-box{flex:1;height:78rpx;padding:0 22rpx;display:flex;align-items:center;border-radius:39rpx;background:#fff;border:1rpx solid var(--dp-border)}.search-box>text{margin-right:12rpx;color:var(--dp-muted);font-size:36rpx}.search-box input{flex:1}.sort-button{width:78rpx;height:78rpx;flex:0 0 78rpx;display:flex;align-items:center;justify-content:center;border-radius:24rpx;background:#fff;border:1rpx solid var(--dp-border);box-sizing:border-box}.sort-button image{width:38rpx;height:38rpx}
.tabs{width:100%;height:72rpx;display:grid;grid-template-columns:repeat(6,minmax(0,1fr));margin-bottom:18rpx;overflow:visible}.tab{min-width:0;position:relative;display:flex;align-items:center;justify-content:center;white-space:nowrap;color:var(--dp-secondary);font-size:25rpx;line-height:1}.tab.active{color:var(--dp-red);font-weight:600}.tab.active::after{content:"";position:absolute;bottom:0;width:42rpx;height:4rpx;border-radius:2rpx;background:var(--dp-red)}
.task-card{min-height:280rpx;margin-bottom:18rpx;padding:24rpx;box-shadow:0 8rpx 24rpx rgba(48,49,51,.06)}.task-card.skeleton{height:280rpx}.task-head{display:flex;align-items:center}.task-mark{width:44rpx;height:44rpx;display:flex;align-items:center;justify-content:center;border-radius:12rpx;color:var(--dp-red);background:var(--dp-red-subtle);font-weight:700}.task-name{flex:1;margin:0 14rpx;font-size:31rpx;font-weight:600}.enter{margin-left:14rpx;color:var(--dp-secondary);font-size:46rpx}.task-info{display:grid;grid-template-columns:120rpx 1fr;row-gap:8rpx;margin-top:20rpx;color:var(--dp-text);font-size:25rpx}.task-info text:nth-child(odd){color:var(--dp-muted)}.progress-row{height:58rpx;margin-top:18rpx;padding:0 14rpx;display:flex;align-items:center;gap:12rpx;border-radius:16rpx;background:#fafafa;color:var(--dp-secondary);font-size:24rpx}.progress{flex:1;height:8rpx;border-radius:4rpx;background:#e5e7eb;overflow:hidden}.progress view{height:100%;background:linear-gradient(90deg,#f96766,#e21413)}.progress-value{min-width:68rpx;text-align:right;color:var(--dp-red);font-size:28rpx;font-weight:700}
.sort-mask{position:fixed;z-index:50;left:0;right:0;top:0;bottom:0;display:flex;align-items:flex-end;background:rgba(23,26,29,.42)}.sort-sheet{width:100%;padding:30rpx 32rpx calc(34rpx + env(safe-area-inset-bottom));border-radius:30rpx 30rpx 0 0;background:#fff}.sort-sheet-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:28rpx}.sort-title{font-size:34rpx;font-weight:700;color:var(--dp-text)}.sort-close{width:56rpx;height:56rpx;display:flex;align-items:center;justify-content:center;color:var(--dp-muted);font-size:42rpx}.sort-section-title{display:block;margin-bottom:14rpx;color:var(--dp-secondary);font-size:24rpx}.sort-options{border:1rpx solid var(--dp-border);border-radius:20rpx;overflow:hidden}.sort-option{min-height:88rpx;padding:16rpx 22rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid var(--dp-border)}.sort-option:last-child{border-bottom:0}.sort-option-name{display:block;color:var(--dp-text);font-size:28rpx}.sort-option-description{display:block;margin-top:4rpx;color:var(--dp-muted);font-size:22rpx}.sort-radio{width:30rpx;height:30rpx;display:flex;align-items:center;justify-content:center;border:2rpx solid #c7cbd1;border-radius:50%}.sort-option.selected .sort-radio{border-color:var(--dp-red)}.sort-option.selected .sort-radio view{width:16rpx;height:16rpx;border-radius:50%;background:var(--dp-red)}.sort-option.selected .sort-option-name{color:var(--dp-red);font-weight:600}.direction-title{margin-top:28rpx}.direction-options{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.direction-option{height:70rpx;display:flex;align-items:center;justify-content:center;border:1rpx solid var(--dp-border);border-radius:16rpx;color:var(--dp-secondary);font-size:27rpx}.direction-option.selected{border-color:#ff9b9b;background:var(--dp-red-subtle);color:var(--dp-red);font-weight:600}.sort-confirm{height:86rpx;margin-top:34rpx;border:0;border-radius:43rpx;background:var(--dp-red);color:#fff;font-size:30rpx;font-weight:600;line-height:86rpx}.sort-confirm::after{border:0}
