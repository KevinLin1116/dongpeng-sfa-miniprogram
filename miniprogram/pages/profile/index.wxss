.profile-card{margin-top:30rpx;padding:34rpx;display:flex;align-items:center;gap:26rpx}.avatar{width:100rpx;height:100rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:linear-gradient(148.66deg,#f96766,#e21413);color:#fff;font-size:42rpx;font-weight:600}.profile-card text{display:block}.profile-name{font-size:34rpx;font-weight:600;margin-bottom:10rpx}.menu{margin-top:24rpx;padding:0 28rpx}.menu>view{height:104rpx;display:flex;align-items:center;border-bottom:1rpx solid var(--dp-border)}.menu>view:last-child{border:0}.menu>view>text:first-child{flex:1}.menu-value{color:#909399;margin-right:16rpx}.badge{min-width:40rpx;height:40rpx;padding:0 10rpx;border-radius:20rpx;background:var(--dp-red);color:#fff;text-align:center;line-height:40rpx;margin-right:16rpx}.version{text-align:center;margin-top:50rpx;color:#a0a6b2}
