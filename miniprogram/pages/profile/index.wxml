<view class="page"><view class="safe-top"></view><view class="nav"><text class="nav-title">我的</text></view><view class="profile-card card"><view class="avatar">{{avatarText}}</view><view><text class="profile-name">{{profile.name}}</text><text>{{profile.roleLabel}}</text></view></view><view class="menu card"><view bindtap="openApprovals"><text>任务审核</text><text wx:if="{{approvalCount}}" class="badge">{{approvalCount}}</text><text>›</text></view><view bindtap="copyUserId"><text>企业微信账号</text><text class="menu-value">{{profile.userId}}</text><text>›</text></view><view><text>登录手机号</text><text class="menu-value">{{profile.mobile || '未设置'}}</text></view><view wx:if="{{isAdmin}}" bindtap="openAccountManagement"><text>账号管理</text><text class="menu-value">开通或重置</text><text>›</text></view><view><text>数据权限</text><text class="menu-value">{{profile.scopeLabel}}</text></view></view><button class="logout-button" bindtap="logout">退出登录</button><view class="version">鹏程SFA · 云开发版</view></view>
