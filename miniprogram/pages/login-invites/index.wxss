.form-card{margin-top:30rpx;padding:38rpx}.tip{display:block;margin:22rpx 0 8rpx;color:var(--dp-secondary);font-size:25rpx;line-height:1.7}.field{margin-top:32rpx}.field>text{display:block;margin-bottom:14rpx;font-weight:600}.field input,.picker{height:90rpx;padding:0 24rpx;border-radius:16rpx;background:#f7f8fa;display:flex;align-items:center;font-size:30rpx}.picker text{margin-left:auto;color:var(--dp-muted);font-size:40rpx}.create-button{margin-top:52rpx;width:100%}
.result-card{margin-top:30rpx;padding:34rpx;display:flex;flex-direction:column;gap:14rpx;background:#fff8f7}.result-title{font-size:34rpx;font-weight:700;color:var(--dp-red)}.password-input{display:flex;align-items:center;border-radius:16rpx;background:#f7f8fa}.password-input input{flex:1}.password-input text{padding:20rpx 24rpx;color:var(--dp-red);font-size:24rpx}
