.sampling-page{height:100vh;background:#fff}.nav{padding:0 28rpx}.sampling-body{position:absolute;left:0;right:0;top:calc(env(safe-area-inset-top) + 112rpx);bottom:148rpx;display:flex;border-top:1rpx solid var(--dp-border)}.sampling-body.read-only{bottom:0}
.group-nav{width:190rpx;background:#fafafa;border-right:1rpx solid var(--dp-border)}.group-section{border-bottom:1rpx solid var(--dp-border)}.group-section-head{min-height:86rpx;padding:0 18rpx;display:flex;align-items:center;justify-content:space-between;color:var(--dp-text)}.group-section-head.active{color:var(--dp-red)}.group-title{font-size:28rpx;font-weight:600}.section-chevron,.product-chevron{width:14rpx;height:14rpx;border-right:3rpx solid currentColor;border-bottom:3rpx solid currentColor;transform:rotate(45deg);transition:transform .18s ease}.section-chevron.expanded,.product-chevron.expanded{transform:rotate(225deg)}.group-children{background:var(--dp-canvas)}.group-nav-item{padding:20rpx 12rpx 22rpx 28rpx;display:flex;flex-direction:column;gap:8rpx;color:var(--dp-secondary);border-left:6rpx solid transparent}.group-nav-item.active{background:var(--dp-red-subtle);color:var(--dp-red);border-left-color:var(--dp-red)}.group-nav-item.error{color:var(--dp-red)}.group-nav-row{display:flex;justify-content:space-between;align-items:center;gap:6rpx}.group-progress{flex:none;font-size:19rpx}.group-check{width:30rpx;height:30rpx;flex:none;border-radius:50%;background:var(--dp-success-subtle);color:var(--dp-success);font-size:21rpx;font-weight:700;line-height:30rpx;text-align:center}.group-subtitle{min-width:0;font-size:23rpx;line-height:1.35}.group-total{font-size:19rpx;color:var(--dp-muted)}.group-nav-item.active .group-total{color:var(--dp-red)}
.products{flex:1;padding:0 24rpx 26rpx;background:#fff}.readonly-banner,.rectify-banner{margin:20rpx 0;padding:18rpx 20rpx;border-radius:12rpx;text-align:center;font-size:24rpx}.readonly-banner{background:var(--dp-canvas);color:var(--dp-secondary)}.rectify-banner{background:var(--dp-red-subtle);color:var(--dp-red);text-align:left}.group-summary{min-height:70rpx;margin:0 -24rpx;padding:0 36rpx;display:flex;align-items:center;gap:18rpx;background:var(--dp-red-subtle);border-bottom:1rpx solid var(--dp-border);color:var(--dp-secondary);font-size:21rpx}.summary-metric{display:flex;align-items:center;white-space:nowrap}.metric-value{font-weight:600;color:var(--dp-text)}.qualification{margin-left:auto;white-space:nowrap;font-size:23rpx;font-weight:600}.qualification.qualified{color:var(--dp-success)}.qualification.unqualified{color:var(--dp-red)}
.product{border-bottom:1rpx solid var(--dp-border)}.product-error{margin-top:16rpx;border:1rpx solid #ffd1d1;border-radius:14rpx;background:var(--dp-red-subtle)}.product-summary{min-height:148rpx;padding:24rpx 4rpx;display:flex;align-items:center;gap:20rpx}.product-thumb{width:90rpx;height:90rpx;flex:none;border-radius:8rpx;background:var(--dp-canvas)}.product-info{min-width:0;flex:1}.product-title-row{display:flex;align-items:center}.product-code{max-width:250rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:28rpx;color:var(--dp-text)}.product-name,.muted{display:block;margin-top:5rpx;line-height:1.35}.product-name{font-size:24rpx;color:var(--dp-text)}.muted{color:var(--dp-muted);font-size:22rpx}.product-chevron{margin:0 8rpx 0 4rpx;color:var(--dp-muted);transform:rotate(45deg)}.product-chevron.expanded{transform:rotate(225deg)}.product-detail{margin:0 -24rpx;padding:22rpx 28rpx 28rpx;background:var(--dp-canvas);border-top:1rpx solid var(--dp-border)}.instructions{display:block;margin-bottom:16rpx;padding:12rpx 14rpx;border-radius:10rpx;background:#fff;color:var(--dp-secondary);font-size:22rpx}.photo-title-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:14rpx}.photo-label{font-size:25rpx;font-weight:500;color:var(--dp-text)}.photo-requirement{color:var(--dp-muted);font-size:20rpx}.validation-error{display:block;margin:-2rpx 0 14rpx;color:var(--dp-red);font-size:22rpx}.photos{display:flex;gap:16rpx;flex-wrap:wrap}.photo,.add-photo{width:106rpx;height:106rpx;border-radius:10rpx}.photo{position:relative}.photo image{width:100%;height:100%;border-radius:10rpx}.photo text{position:absolute;right:-9rpx;top:-12rpx;width:32rpx;height:32rpx;border-radius:50%;background:var(--dp-red);color:#fff;line-height:29rpx;text-align:center}.add-photo{display:flex;flex-direction:column;align-items:center;justify-content:center;border:2rpx dashed var(--dp-border);background:#fff;color:var(--dp-muted)}.add-photo-plus{font-size:40rpx;line-height:38rpx;font-weight:300}.add-photo-text{margin-top:6rpx;font-size:19rpx;line-height:22rpx}.fixed-footer .primary-button{width:100%;border:0}
.product-qualified{background:#fbfefc}.product-rectify{background:#fffafa}.product-rejection{display:block;margin-top:8rpx;color:var(--dp-red);font-size:20rpx;line-height:1.45}.qualified-product-badge{flex:none;padding:7rpx 12rpx;border-radius:18rpx;background:var(--dp-success-subtle);color:var(--dp-success);font-size:20rpx;font-weight:600}
.autosave-notice{position:fixed;z-index:35;left:50%;top:calc(env(safe-area-inset-top) + 130rpx);transform:translateX(-50%);width:420rpx;min-height:82rpx;padding:14rpx 20rpx;display:flex;align-items:center;gap:14rpx;border:1rpx solid var(--dp-border);border-radius:16rpx;background:rgba(255,255,255,.98);box-shadow:0 10rpx 30rpx rgba(48,49,51,.16)}.autosave-symbol{width:42rpx;height:42rpx;flex:none;display:flex;align-items:center;justify-content:center;border-radius:50%;font-size:25rpx;font-weight:600}.autosave-saving .autosave-symbol{background:var(--dp-processing-subtle);color:var(--dp-processing)}.autosave-saved .autosave-symbol{background:var(--dp-success-subtle);color:var(--dp-success)}.autosave-failed .autosave-symbol{background:var(--dp-red-subtle);color:var(--dp-red)}.autosave-spinner{width:20rpx;height:20rpx;border:3rpx solid currentColor;border-right-color:transparent;border-radius:50%;animation:autosave-spin .8s linear infinite}.autosave-copy,.autosave-title,.autosave-message{display:block}.autosave-copy{min-width:0}.autosave-title{color:var(--dp-text);font-size:23rpx;font-weight:600}.autosave-message{margin-top:3rpx;color:var(--dp-muted);font-size:19rpx;line-height:1.35}@keyframes autosave-spin{to{transform:rotate(360deg)}}
.save-alert-mask{position:fixed;z-index:50;left:0;right:0;top:0;bottom:0;padding:40rpx;display:flex;align-items:center;justify-content:center;background:rgba(22,25,31,.48)}.save-alert-panel{width:100%;max-width:640rpx;max-height:72vh;display:flex;flex-direction:column;border-radius:28rpx;background:#fff;box-shadow:0 24rpx 70rpx rgba(0,0,0,.22);overflow:hidden}.save-alert-head{padding:32rpx 32rpx 22rpx;display:flex;align-items:flex-start;gap:18rpx;border-bottom:1rpx solid var(--dp-border)}.save-alert-symbol{width:50rpx;height:50rpx;flex:none;display:flex;align-items:center;justify-content:center;border-radius:50%;background:var(--dp-red-subtle);color:var(--dp-red);font-size:30rpx;font-weight:700}.save-alert-heading,.save-alert-title,.save-alert-summary{display:block}.save-alert-heading{min-width:0;flex:1}.save-alert-title{color:var(--dp-text);font-size:31rpx;font-weight:600;line-height:1.3}.save-alert-summary{margin-top:8rpx;color:var(--dp-secondary);font-size:23rpx;line-height:1.5}.save-alert-content{max-height:48vh;padding:24rpx 32rpx}.save-alert-message{display:block;padding:20rpx;border-radius:14rpx;background:var(--dp-canvas);color:var(--dp-text);font-size:24rpx;line-height:1.65;word-break:break-all}.save-alert-list{display:flex;flex-direction:column;gap:16rpx}.save-alert-item{padding:18rpx 20rpx;display:flex;align-items:flex-start;gap:14rpx;border-radius:14rpx;background:var(--dp-red-subtle)}.save-alert-index{width:34rpx;height:34rpx;flex:none;display:flex;align-items:center;justify-content:center;border-radius:50%;background:var(--dp-red);color:#fff;font-size:19rpx;line-height:34rpx;text-align:center}.save-alert-item-text{flex:1;color:var(--dp-text);font-size:23rpx;line-height:1.55;word-break:break-all}.save-alert-actions{padding:22rpx 32rpx calc(22rpx + env(safe-area-inset-bottom));display:flex;gap:18rpx;border-top:1rpx solid var(--dp-border)}.save-alert-actions button{height:78rpx;display:flex;align-items:center;justify-content:center;border-radius:39rpx;font-size:26rpx;font-weight:600}.save-alert-secondary{flex:1;background:var(--dp-canvas);color:var(--dp-secondary)}.save-alert-primary{flex:1;background:linear-gradient(148.66deg,var(--dp-red-start) 0%,var(--dp-red) 100%);color:#fff}
