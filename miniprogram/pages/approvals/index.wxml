<view class="page"><view class="safe-top"></view><view class="nav"><view class="nav-back" bindtap="goBack">‹</view><text class="nav-title">任务审核</text></view><view class="approval-tabs"><view wx:for="{{tabs}}" wx:key="key" class="approval-tab {{active===item.key?'active':''}}" data-key="{{item.key}}" bindtap="changeTab">{{item.label}}</view></view>
  <view wx:if="{{loading}}" class="empty">正在加载…</view><view wx:else><view wx:for="{{approvals}}" wx:key="id" class="approval-card card" data-id="{{item.id}}" bindtap="open"><view class="approval-head"><text>{{item.itemName}}</text><text class="status status-{{item.status==='pending'?'review':'completed'}}">{{item.statusLabel}}</text></view><view class="approval-name">{{item.taskName}}</view><view class="approval-grid"><text>任务门店</text><text>{{item.storeName}}</text><text>提交人</text><text>{{item.submitterName}}</text><text>提交时间</text><text>{{item.submittedText}}</text></view></view><view wx:if="{{!approvals.length}}" class="empty">当前没有审核任务</view></view>
</view>
