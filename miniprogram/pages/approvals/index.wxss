.approvals-page{padding-bottom:60rpx}.approval-tabs{display:flex;padding:8rpx;margin-top:18rpx}.approval-tab{flex:1;height:76rpx;display:flex;align-items:center;justify-content:center;color:var(--dp-secondary);font-size:28rpx}.approval-tab.active{border-radius:16rpx;background:#fff1f1;color:var(--dp-red);font-weight:600}.filter-card{margin-top:20rpx}.filter-item{display:block;width:100%}.filter-line{height:82rpx;padding:0 24rpx;display:flex;align-items:center}.filter-label{flex:none;color:var(--dp-secondary);font-size:25rpx;font-weight:600}.filter-value{min-width:0;flex:1;margin-left:16rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--dp-muted);font-size:24rpx;text-align:right}.filter-arrow{margin-left:12rpx;color:#a8acb4;font-size:28rpx}.approval-card{margin-top:20rpx;padding:26rpx 28rpx}.approval-top{display:flex;align-items:center;justify-content:space-between}.type-tag{max-width:390rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:8rpx 14rpx;border-radius:10rpx;background:#fff1f1;color:var(--dp-red);font-size:23rpx;font-weight:600}.approval-name{display:block;margin:20rpx 0 22rpx;font-size:32rpx;font-weight:700;line-height:1.4}.approval-item{display:grid;grid-template-columns:132rpx 1fr;gap:16rpx;margin-top:12rpx;line-height:1.45;font-size:26rpx}.approval-item text:first-child{color:var(--dp-muted)}.approval-item text:last-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--dp-secondary)}.approval-foot{display:flex;justify-content:space-between;margin-top:24rpx;padding-top:20rpx;border-top:1rpx solid var(--dp-border);color:var(--dp-muted);font-size:23rpx}.approval-foot text:last-child{color:var(--dp-red);font-weight:600}
