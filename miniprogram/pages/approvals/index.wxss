.approval-tabs{display:flex;background:#fff;border-radius:18rpx;padding:8rpx;margin:20rpx 0}.approval-tab{flex:1;text-align:center;padding:20rpx;color:#606266}.approval-tab.active{background:#fff1f1;color:var(--dp-red);border-radius:14rpx;font-weight:600}.approval-card{margin-top:20rpx;padding:28rpx}.approval-head{display:flex;align-items:center;justify-content:space-between}.approval-head>text:first-child{font-size:30rpx;font-weight:600}.approval-name{font-size:32rpx;font-weight:600;margin:26rpx 0}.approval-grid{display:grid;grid-template-columns:130rpx 1fr;gap:14rpx}.approval-grid text:nth-child(odd){color:#909399}
