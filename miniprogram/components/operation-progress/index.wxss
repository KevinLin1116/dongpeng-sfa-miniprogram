.operation-mask{position:fixed;z-index:90;inset:0;padding:calc(env(safe-area-inset-top) + 154rpx) 34rpx 0;background:rgba(22,25,31,.34);box-sizing:border-box}
.operation-panel{width:100%;padding:28rpx 28rpx 26rpx;display:flex;align-items:flex-start;gap:22rpx;border:1rpx solid rgba(255,255,255,.72);border-radius:24rpx;background:rgba(255,255,255,.98);box-shadow:0 22rpx 64rpx rgba(24,27,33,.22);box-sizing:border-box}
.operation-status{width:58rpx;height:58rpx;flex:none;display:flex;align-items:center;justify-content:center;border-radius:50%}.operation-status-processing{background:#fff0f0;color:#e60012}.operation-status-success{background:#ecf9f1;color:#16a05d}
.operation-spinner{width:25rpx;height:25rpx;border:4rpx solid currentColor;border-right-color:transparent;border-radius:50%;animation:operation-spin .78s linear infinite}.operation-check{width:24rpx;height:13rpx;border-left:5rpx solid currentColor;border-bottom:5rpx solid currentColor;transform:rotate(-45deg) translate(2rpx,-2rpx)}
.operation-copy{min-width:0;flex:1}.operation-title-row{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.operation-title{color:#1f2329;font-size:30rpx;font-weight:600;line-height:1.35}.operation-stage{flex:none;padding:5rpx 12rpx;border-radius:18rpx;background:#fff0f0;color:#e60012;font-size:20rpx}.operation-message{display:block;margin-top:9rpx;color:#4e5969;font-size:24rpx;line-height:1.55}.operation-track{height:6rpx;margin-top:20rpx;overflow:hidden;border-radius:3rpx;background:#f0f1f3}.operation-track-active{width:38%;height:100%;border-radius:3rpx;background:linear-gradient(90deg,#ff6565,#e60012);animation:operation-track 1.25s ease-in-out infinite}.operation-meta{margin-top:14rpx;display:flex;justify-content:space-between;gap:18rpx;color:#86909c;font-size:20rpx;line-height:1.4}.operation-meta text:last-child{text-align:right}
@keyframes operation-spin{to{transform:rotate(360deg)}}@keyframes operation-track{0%{transform:translateX(-110%)}100%{transform:translateX(270%)}}
